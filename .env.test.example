# .env.test.example — copy to .env.test and fill in your local values.
# .env.test is gitignored; this file is committed as documentation.
#
# Required for backend integration tests that exercise the database.
# If DATABASE_URL is unset, database-dependent tests will skip or error clearly.
#
# Local Docker (docker compose up -d postgres):
DATABASE_URL=postgresql://epapere:epapere_dev@localhost:5432/epapere_test
#
# Or a Neon dev-branch direct connection (not the pooler — migrations use DIRECT_DATABASE_URL):
# DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/epapere_test?sslmode=require
# DIRECT_DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/epapere_test?sslmode=require
